# Copy to .env (git-ignored). Real environment variables always win over this file.

# --- Provider secrets (referenced from config/providers.yaml as ${VAR}) ---
OPENROUTER_API_KEY=

# --- App security ---
# REQUIRED if the server binds to a non-loopback address.
VIBE_AUTH_TOKEN=
# Comma-separated absolute paths agents are allowed to operate in.
VIBE_WORKSPACE_ROOTS=

# --- Storage ---
VIBE_DB_URL=sqlite+aiosqlite:///./data/vibe.db

# --- Generic overrides: VIBE_<SECTION>__<KEY> (see config/app.yaml) ---
# VIBE_SERVER__PORT=8000
# VIBE_RUNNER__CONCURRENCY=4
# VIBE_RESILIENCE__MAX_ATTEMPTS=3
